{
  "name": "daw-multitrack",
  "version": "0.1.0",
  "private": true,
  "description": "Reproductor multitrack sincronizado para ministerio de alabanza (Electron + Express + Socket.IO)",
  "main": "out/main/index.cjs",
  "type": "commonjs",
  "scripts": {
    "dev:renderer": "vite --config src/renderer/vite.config.ts",
    "build:renderer": "vite build --config src/renderer/vite.config.ts",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "modelos": "npm run build:main && node out/main/modelos-cli.cjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p src/renderer/tsconfig.json",
    "test:server": "npm run build:main && node --test out/main/analisis.test.cjs out/main/server.test.cjs out/main/automatico.test.cjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test:e2e": "npm run build && node --test --test-reporter=spec out/main/e2e.test.cjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "node-unrar-js": "^2.0.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.48.0",
    "nosleep.js": "^0.12.0",
    "playwright": "^1.56.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "productName": "Multitrack Alabanza",
  "author": "Multitrack Alabanza",
  "build": {
    "appId": "com.multitrack.alabanza",
    "productName": "Multitrack Alabanza",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/main/index.cjs",
      "out/main/preload.cjs",
      "out/main/extraer.cjs",
      "out/renderer/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Multitrack Alabanza"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": "AppImage",
      "category": "Audio"
    },
    "extraResources": [
      {
        "from": "modelos",
        "to": "modelos",
        "filter": [
          "**/*",
          "!**/*.parte"
        ]
      }
    ]
  }
}
