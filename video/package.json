{
  "name": "airtracks-video",
  "version": "0.1.0",
  "private": true,
  "description": "AirTracks Video: el video con la letra en el proyector, siguiendo a AirTracks",
  "main": "out/main.cjs",
  "productName": "AirTracks Video",
  "author": "AirTracks",
  "scripts": {
    "build": "cd .. && node scripts/build-video.mjs",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --ia32 --x64"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.airtracks.video",
    "productName": "AirTracks Video",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "AirTracks Video",
      "artifactName": "AirTracks-Video-Instalador.${ext}"
    },
    "publish": null
  }
}
